{
  "name": "TSMHST Portal — Tricent School of Medical Health Science and Technology",
  "short_name": "TSMHST Portal",
  "description": "Student and staff portal for Tricent School of Medical Health Science and Technology: units, assignments, results, transcripts, fees, hostel, attendance and campus notices.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f3f6f0",
  "theme_color": "#3f8f1f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My units", "short_name": "Units", "url": "./#/units", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Attendance", "short_name": "Attendance", "url": "./#/attendance", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Results", "short_name": "Results", "url": "./#/results", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Fees", "short_name": "Fees", "url": "./#/fees", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
